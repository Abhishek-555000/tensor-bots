# ==============================================================================
# Agent Crew Workshop - Environment Configuration Example
# ==============================================================================
LLM_PROVIDER=gemini

# Google Gemini (Free Tier from Google AI Studio: https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud (Free Tier from Groq Console: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Execution & Review Settings
MAX_REVIEW_ROUNDS=2
REQUEST_TIMEOUT_SECONDS=60

# Safety net: 1 = deterministic canned responses offline; 0 = real LLM
MOCK_LLM=0
